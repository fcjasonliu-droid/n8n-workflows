<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>ai.jason.log-disk-guard</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>/Users/jason/.hermes/scripts/log-disk-guard.sh</string>
	</array>
	<!-- 每 5 分钟：给无上限日志兜底 + 磁盘水位告警 + 留磁盘历史 -->
	<key>StartInterval</key>
	<integer>300</integer>
	<key>RunAtLoad</key>
	<true/>
	<key>WorkingDirectory</key>
	<string>/Users/jason</string>
	<key>StandardOutPath</key>
	<string>/Users/jason/.hermes/logs/log-disk-guard.out.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/jason/.hermes/logs/log-disk-guard.err.log</string>
	<key>Comment</key>
	<string>2026-09-27 建立：因 n8n 发布索引死循环写出 72GB 日志导致磁盘 95% 满</string>
</dict>
</plist>
